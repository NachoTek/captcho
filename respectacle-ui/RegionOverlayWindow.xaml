<!-- RegionOverlayWindow.xaml — Full-desktop overlay for rectangular region selection.

Layout (screenshot background with dim scrim):
  ┌──────────────────────────────────────────────────────┐
  │  Screenshot + dim scrim                              │
  │                                                      │
  │  ┌──────────────────────┐  ← Selection rectangle    │
  │  │  Clear (no scrim)    │     with blue border       │
  │  └──────────────────────┘                            │
  │                                                      │
  │  [Instruction text at top]                           │
  │  [Status/dimensions at bottom]                       │
  └──────────────────────────────────────────────────────┘

The overlay captures the screen at the moment the user clicks the region
button, displays that screenshot with a light dim scrim, and lets the user
drag-select a region. This is the same approach used by Snipping Tool,
Greenshot, and ShareX.

Input contract:
  - Drag to draw a selection rectangle
  - Enter or double-click to confirm
  - Escape to cancel
  - Arrow keys to nudge (10px), Shift+Arrow for fine nudge (1px)
  - Alt+Arrow to resize from bottom-right anchor
-->
<Window
    x:Class="Respectacle.UI.RegionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Canvas x:Name="RootCanvas"
            Background="Transparent">

        <!-- Pre-captured screenshot of the virtual desktop displayed as background.
             The user sees exactly what was on screen when they clicked the region
             button — same behavior as Windows Snipping Tool and Greenshot. -->
        <Image x:Name="BackgroundImage"
               Stretch="Fill"
               IsHitTestVisible="False"/>

        <!-- Dim scrim over the screenshot to indicate selection mode.
             #30000000 = 19% black — light enough to read content clearly. -->
        <Rectangle x:Name="ScrimRect"
                   Fill="#30000000"
                   IsHitTestVisible="False"/>

        <!-- Selection rectangle: dashed blue border, clear interior shows
             the undimmed screenshot underneath. -->
        <Rectangle x:Name="SelectionRect"
                   Stroke="#4FC3F7"
                   StrokeThickness="2"
                   StrokeDashArray="6,3"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>

        <!-- Instruction text — top-center -->
        <Border x:Name="InstructionBorder"
                Canvas.ZIndex="10"
                Background="#CC000000"
                CornerRadius="6"
                Padding="16,8">
            <TextBlock x:Name="InstructionText"
                       Text="Drag to select a region · Enter to confirm · Escape to cancel · Arrows to adjust"
                       Foreground="White"
                       FontSize="14"
                       TextAlignment="Center"/>
        </Border>

        <!-- Status text — bottom-center -->
        <Border x:Name="StatusBorder"
                Canvas.ZIndex="10"
                Background="#CC000000"
                CornerRadius="6"
                Padding="16,8">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       Foreground="#B0BEC5"
                       FontSize="13"
                       FontFamily="Consolas, Cascadia Mono, Courier New"
                       TextAlignment="Center"/>
        </Border>

    </Canvas>
</Window>
