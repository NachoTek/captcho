<!-- RegionOverlayWindow.xaml — Full-desktop overlay for rectangular region selection.

Layout (covers entire virtual desktop with pre-captured screenshot):
  ┌──────────────────────────────────────────────────────┐
  │  Screenshot + dim scrim                              │
  │                                                      │
  │  ┌──────────────────────┐  ← Selection rectangle    │
  │  │  Bright (no scrim)   │     with blue border       │
  │  └──────────────────────┘                            │
  │                                                      │
  │  [Instruction text at top]                           │
  │  [Status/dimensions at bottom]                       │
  └──────────────────────────────────────────────────────┘

The overlay displays a pre-captured screenshot of the virtual desktop,
dims it with a semi-transparent scrim, and lets the user drag a selection
rectangle. The selected area is shown without the dim overlay so the user
can see exactly what they're capturing.

Input contract:
  - Drag to draw a selection rectangle
  - Enter or double-click to confirm
  - Escape to cancel
  - Arrow keys to nudge (10px), Shift+Arrow for fine nudge (1px)
  - Alt+Arrow to resize from bottom-right anchor
-->
<Window
    x:Class="Respectacle.UI.RegionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Canvas x:Name="RootCanvas">

        <!-- Pre-captured screenshot of the virtual desktop.
             Sized in code to fill the canvas in DIPs. -->
        <Image x:Name="BackgroundImage"
               Stretch="Fill"
               IsHitTestVisible="False"/>

        <!-- Dim scrim over the entire screenshot to indicate selection mode.
             #40000000 = 25% black — dark enough to notice, light enough to
             read content underneath. -->
        <Rectangle x:Name="ScrimRect"
                   Fill="#40000000"
                   IsHitTestVisible="False"/>

        <!-- Clear window inside the selection — punches through the scrim
             so the selected area shows the undimmed screenshot at full brightness. -->
        <Rectangle x:Name="SelectionClearRect"
                   Fill="White"
                   Opacity="0"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>

        <!-- Selection rectangle border: dashed blue outline for clear boundary. -->
        <Rectangle x:Name="SelectionRect"
                   Stroke="#4FC3F7"
                   StrokeThickness="2"
                   StrokeDashArray="6,3"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>

        <!-- Instruction text — top-center -->
        <Border x:Name="InstructionBorder"
                Canvas.ZIndex="10"
                Background="#CC000000"
                CornerRadius="6"
                Padding="16,8">
            <TextBlock x:Name="InstructionText"
                       Text="Drag to select a region · Enter to confirm · Escape to cancel · Arrows to adjust"
                       Foreground="White"
                       FontSize="14"
                       TextAlignment="Center"/>
        </Border>

        <!-- Status text — bottom-center -->
        <Border x:Name="StatusBorder"
                Canvas.ZIndex="10"
                Background="#CC000000"
                CornerRadius="6"
                Padding="16,8">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       Foreground="#B0BEC5"
                       FontSize="13"
                       FontFamily="Consolas, Cascadia Mono, Courier New"
                       TextAlignment="Center"/>
        </Border>

    </Canvas>
</Window>
