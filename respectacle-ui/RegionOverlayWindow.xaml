<!-- RegionOverlayWindow.xaml — Full-desktop overlay for rectangular region selection.

Layout (covers entire virtual desktop, semi-transparent background):
  ┌──────────────────────────────────────────────────────┐
  │  Semi-transparent dark scrim                         │
  │                                                      │
  │  ┌──────────────────────┐  ← Selection rectangle    │
  │  │  Clear (no scrim)    │     with dashed border     │
  │  └──────────────────────┘                            │
  │                                                      │
  │  [Instruction text at top]                           │
  │  [Status/dimensions at bottom]                       │
  └──────────────────────────────────────────────────────┘

Input contract:
  - Drag to draw a selection rectangle
  - Enter or double-click to confirm
  - Escape to cancel
  - Arrow keys to nudge (10px), Shift+Arrow for fine nudge (1px)
  - Alt+Arrow to resize from bottom-right anchor
-->
<Window
    x:Class="Respectacle.UI.RegionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Canvas x:Name="RootCanvas">

        <!-- Light tint over the entire desktop — transparent enough to see
             content underneath while clearly indicating selection mode.
             #30000000 = ~19% black opacity -->
        <Rectangle x:Name="ScrimRect"
                   Fill="#30000000"
                   IsHitTestVisible="False"/>

        <!-- Selection rectangle: bright interior highlights the selected area,
             dashed blue border provides clear boundary.
             #18FFFFFF = subtle white tint so the selected area is visibly
             brighter than the dimmed surroundings. -->
        <Rectangle x:Name="SelectionRect"
                   Fill="#18FFFFFF"
                   Stroke="#4FC3F7"
                   StrokeThickness="2"
                   StrokeDashArray="6,3"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>

        <!-- Instruction text — top-center -->
        <Border x:Name="InstructionBorder"
                Canvas.ZIndex="10"
                Background="#CC000000"
                CornerRadius="6"
                Padding="16,8">
            <TextBlock x:Name="InstructionText"
                       Text="Drag to select a region · Enter to confirm · Escape to cancel · Arrows to adjust"
                       Foreground="White"
                       FontSize="14"
                       TextAlignment="Center"/>
        </Border>

        <!-- Status text — bottom-center -->
        <Border x:Name="StatusBorder"
                Canvas.ZIndex="10"
                Background="#CC000000"
                CornerRadius="6"
                Padding="16,8">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       Foreground="#B0BEC5"
                       FontSize="13"
                       FontFamily="Consolas, Cascadia Mono, Courier New"
                       TextAlignment="Center"/>
        </Border>

    </Canvas>
</Window>
