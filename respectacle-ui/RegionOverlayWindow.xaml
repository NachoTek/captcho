<!-- RegionOverlayWindow.xaml — Full-desktop overlay for rectangular region selection.

Layout (transparent window over live desktop):
  ┌──────────────────────────────────────────────────────┐
  │  Transparent window + dim scrim (live desktop below) │
  │                                                      │
  │  ┌──────────────────────┐  ← Selection rectangle    │
  │  │  Clear (no scrim)    │     with blue border       │
  │  └──────────────────────┘                            │
  │                                                      │
  │  [Instruction text at top]                           │
  │  [Status/dimensions at bottom]                       │
  └──────────────────────────────────────────────────────┘

The window is made transparent via DWM composition so the live desktop
is visible. A semi-transparent scrim dims the desktop to indicate
selection mode. The selected area punches through the scrim.

Input contract:
  - Drag to draw a selection rectangle
  - Enter or double-click to confirm
  - Escape to cancel
  - Arrow keys to nudge (10px), Shift+Arrow for fine nudge (1px)
  - Alt+Arrow to resize from bottom-right anchor
-->
<Window
    x:Class="Respectacle.UI.RegionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Canvas x:Name="RootCanvas"
            Background="Transparent">

        <!-- Dim scrim over the transparent window to indicate selection mode.
             #40000000 = 25% black — the live desktop is visible through both
             the DWM-transparent window and this semi-transparent scrim. -->
        <Rectangle x:Name="ScrimRect"
                   Fill="#40000000"
                   IsHitTestVisible="False"/>

        <!-- Selection rectangle border: dashed blue outline for clear boundary. -->
        <Rectangle x:Name="SelectionRect"
                   Stroke="#4FC3F7"
                   StrokeThickness="2"
                   StrokeDashArray="6,3"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>

        <!-- Instruction text — top-center -->
        <Border x:Name="InstructionBorder"
                Canvas.ZIndex="10"
                Background="#CC000000"
                CornerRadius="6"
                Padding="16,8">
            <TextBlock x:Name="InstructionText"
                       Text="Drag to select a region · Enter to confirm · Escape to cancel · Arrows to adjust"
                       Foreground="White"
                       FontSize="14"
                       TextAlignment="Center"/>
        </Border>

        <!-- Status text — bottom-center -->
        <Border x:Name="StatusBorder"
                Canvas.ZIndex="10"
                Background="#CC000000"
                CornerRadius="6"
                Padding="16,8">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       Foreground="#B0BEC5"
                       FontSize="13"
                       FontFamily="Consolas, Cascadia Mono, Courier New"
                       TextAlignment="Center"/>
        </Border>

    </Canvas>
</Window>
