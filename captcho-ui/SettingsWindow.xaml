<!-- SettingsWindow.xaml — Settings dialog with tabbed configuration pages.

Layout:
  ┌─────────────────────────────────────────┐
  │  TabView: General, Hotkeys, Export,    │
  │            Interface                    │
  ├─────────────────────────────────────────┤
  │  [OK] [Cancel] [Apply]   [Save status] │
  └─────────────────────────────────────────┘
-->
<Window
    x:Class="captcho.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="captcho Settings">

    <Grid RowSpacing="0" Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TabView row -->
        <TabView Grid.Row="0" Padding="16,16">
            <TabViewItem Header="General">
                <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Save Location"
                                   FontSize="14" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SaveLocationInput"
                                     Grid.Column="0"
                                     TextChanged="SaveLocationInput_TextChanged"
                                     PlaceholderText="e.g. C:\Users\you\Pictures\Captures"
                                     MinWidth="400" MaxWidth="600"
                                     HorizontalAlignment="Stretch"/>
                            <Button x:Name="BrowseSaveLocationButton"
                                    Grid.Column="1"
                                    Content="Browse…"
                                    Click="BrowseSaveLocationButton_Click"
                                    MinHeight="36"
                                    CornerRadius="6"/>
                        </Grid>
                        <TextBlock x:Name="SaveLocationErrorText"
                                   Foreground="{ThemeResource TextFillColorCriticalBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                        <TextBlock Text="Filename Template"
                                   FontSize="14" FontWeight="SemiBold"/>
                        <TextBox x:Name="FilenameTemplateInput"
                                 TextChanged="FilenameTemplateInput_TextChanged"
                                 PlaceholderText="e.g. captcho_&lt;yyyy&gt;-&lt;MM&gt;-&lt;dd&gt;_&lt;hh&gt;&lt;mm&gt;&lt;ss&gt;"
                                 MinWidth="400" MaxWidth="600"
                                 HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="FilenameTemplateErrorText"
                                   Foreground="{ThemeResource TextFillColorCriticalBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                        <TextBlock Text="Preview"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="FilenameTemplatePreviewText"
                                   FontSize="13" FontFamily="Consolas"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Available placeholders"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="PlaceholdersList"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Hotkeys">
                <StackPanel Spacing="12" Padding="20">
                    <TextBlock Text="Hotkey configuration is not implemented yet."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="14"/>
                    <TextBlock Text="This tab will allow you to customize global keyboard shortcuts."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               FontSize="13"/>
                </StackPanel>
            </TabViewItem>

            <TabViewItem Header="Export">
                <StackPanel Spacing="12" Padding="20">
                    <TextBlock Text="Export settings are not implemented yet."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="14"/>
                    <TextBlock Text="This tab will contain export format and quality options."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               FontSize="13"/>
                </StackPanel>
            </TabViewItem>

            <TabViewItem Header="Interface">
                <StackPanel Spacing="12" Padding="20">
                    <TextBlock Text="Interface settings are not implemented yet."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="14"/>
                    <TextBlock Text="This tab will contain UI customization options."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               FontSize="13"/>
                </StackPanel>
            </TabViewItem>
        </TabView>

        <!-- Command buttons and status row -->
        <Grid Grid.Row="1" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="OKButton"
                    Grid.Column="0"
                    Content="OK"
                    MinWidth="80" MinHeight="36"
                    Margin="0,0,8,0"
                    Click="OK_Click"
                    CornerRadius="6"/>

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Cancel"
                    MinWidth="80" MinHeight="36"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"
                    CornerRadius="6"/>

            <Button x:Name="ApplyButton"
                    Grid.Column="2"
                    Content="Apply"
                    MinWidth="80" MinHeight="36"
                    Margin="0,0,16,0"
                    Click="Apply_Click"
                    CornerRadius="6"/>

            <TextBlock x:Name="SaveStatusText"
                       Grid.Column="4"
                       Text=""
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="13"/>
        </Grid>
    </Grid>
</Window>