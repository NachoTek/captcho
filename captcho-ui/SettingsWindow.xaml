<!-- SettingsWindow.xaml — Settings dialog with tabbed configuration pages.

Layout:
  ┌─────────────────────────────────────────┐
  │  TabView: General, Global Hotkeys, Capture,  │
  │            Annotation, Behavior, Export,     │
  │            Interface                         │
  ├─────────────────────────────────────────┤
  │ [Reset to Defaults] [OK] [Cancel] [Apply]   [Save status] │
  └─────────────────────────────────────────┘
-->
<Window
    x:Class="captcho.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="captcho Settings">

    <Grid RowSpacing="0" Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TabView row -->
        <TabView Grid.Row="0" Padding="16,16">
            <TabViewItem Header="General">
                <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Save Location"
                                   FontSize="14" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SaveLocationInput"
                                     Grid.Column="0"
                                     TextChanged="SaveLocationInput_TextChanged"
                                     PlaceholderText="e.g. C:\Users\you\Pictures\Captures"
                                     MinWidth="400" MaxWidth="600"
                                     HorizontalAlignment="Stretch"/>
                            <Button x:Name="BrowseSaveLocationButton"
                                    Grid.Column="1"
                                    Content="Browse…"
                                    Click="BrowseSaveLocationButton_Click"
                                    MinHeight="36"
                                    CornerRadius="6"/>
                        </Grid>
                        <TextBlock x:Name="SaveLocationErrorText"
                                   Foreground="{ThemeResource TextFillColorCriticalBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                        <TextBlock Text="Filename Template"
                                   FontSize="14" FontWeight="SemiBold"/>
                        <TextBox x:Name="FilenameTemplateInput"
                                 TextChanged="FilenameTemplateInput_TextChanged"
                                 PlaceholderText="e.g. captcho_&lt;yyyy&gt;-&lt;MM&gt;-&lt;dd&gt;_&lt;hh&gt;&lt;mm&gt;&lt;ss&gt;"
                                 MinWidth="400" MaxWidth="600"
                                 HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="FilenameTemplateErrorText"
                                   Foreground="{ThemeResource TextFillColorCriticalBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                        <TextBlock Text="Preview"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="FilenameTemplatePreviewText"
                                   FontSize="13" FontFamily="Consolas"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Available placeholders"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="PlaceholdersList"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Global Hotkeys">
                <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Global Hotkeys"
                                   FontSize="16" FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level1"/>
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Toggle which Global Hotkeys are active and record new key combinations. Changes take effect on Apply or OK and persist for future launches. Suspected conflicts are warned about when you record; a combination that fails to register marks its row inactive."/>
                        <StackPanel x:Name="GlobalHotkeysRowsPanel" Spacing="8"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Capture">
                <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Capture Settings"
                                   FontSize="16" FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level1"/>
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Persistent defaults for what each Capture includes. The mouse pointer applies to every mode; window decorations and shadow apply to window Captures only. Window shadow is available only when window decorations are included."/>
                        <ToggleSwitch x:Name="AnnotationEnabledToggle"
                                      Header="Open captures in Annotation"
                                      OnContent="On"
                                      OffContent="Off"
                                      Toggled="AnnotationEnabledToggle_Toggled"
                                      MinWidth="200"/>
                        <ToggleSwitch x:Name="CapturePointerToggle"
                                      Header="Include mouse pointer"
                                      OnContent="On"
                                      OffContent="Off"
                                      Toggled="CapturePointerToggle_Toggled"
                                      MinWidth="200"/>
                        <ToggleSwitch x:Name="CaptureDecorationsToggle"
                                      Header="Include window decorations"
                                      OnContent="On"
                                      OffContent="Off"
                                      Toggled="CaptureDecorationsToggle_Toggled"
                                      MinWidth="200"/>
                        <ToggleSwitch x:Name="CaptureShadowToggle"
                                      Header="Include window shadow"
                                      OnContent="On"
                                      OffContent="Off"
                                      Toggled="CaptureShadowToggle_Toggled"
                                      MinWidth="200"/>
                        <TextBlock x:Name="CaptureShadowNoteText"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="Window shadow requires window decorations."/>
                        <TextBlock Text="Remember Selection"
                                   Margin="0,8,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <ComboBox x:Name="RememberSelectionCombo"
                                  Header="Selection lifetime"
                                  MinWidth="240"
                                  SelectionChanged="RememberSelectionCombo_SelectionChanged">
                            <ComboBoxItem Content="Never"/>
                            <ComboBoxItem Content="Session"/>
                            <ComboBoxItem Content="Always"/>
                        </ComboBox>
                        <TextBlock FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="Never starts each Selection clean. Session reuses it until Captcho exits. Always reuses it across restarts while the monitor layout remains compatible."/>
                        <TextBlock Text="Text Recognition (OCR)"
                                   Margin="0,8,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <ComboBox x:Name="OcrLanguageCombo"
                                  Header="Recognition language"
                                  MinWidth="280"
                                  SelectionChanged="OcrLanguageCombo_SelectionChanged"/>
                        <TextBlock FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="Languages come from the OCR language packs installed with Windows. Default uses your Windows preferred languages. Install additional packs under Settings → Time &amp; language → Language &amp; region."/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Annotation">
                <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Annotation Defaults"
                                   FontSize="16" FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level1"/>
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="These defaults initialize each post-capture Annotation session. Changes affect new strokes, not existing annotations."/>
                        <ComboBox x:Name="AnnotationToolCombo"
                                  Header="Default tool"
                                  MinWidth="240"
                                  SelectionChanged="AnnotationToolCombo_SelectionChanged">
                            <ComboBoxItem Content="Pen"/>
                            <ComboBoxItem Content="Rectangle"/>
                            <ComboBoxItem Content="Ellipse"/>
                            <ComboBoxItem Content="Line"/>
                            <ComboBoxItem Content="Arrow"/>
                            <ComboBoxItem Content="Text"/>
                            <ComboBoxItem Content="Marker"/>
                        </ComboBox>
                        <ComboBox x:Name="AnnotationPenColorCombo"
                                  Header="Pen color"
                                  MinWidth="240"
                                  SelectionChanged="AnnotationPenColorCombo_SelectionChanged">
                            <ComboBoxItem Content="Red"/>
                            <ComboBoxItem Content="Blue"/>
                            <ComboBoxItem Content="Black"/>
                        </ComboBox>
                        <NumberBox x:Name="AnnotationStrokeWidthInput"
                                   Header="Pen stroke width (pixels)"
                                   Minimum="1" Maximum="64"
                                   SmallChange="1" LargeChange="4"
                                   SpinButtonPlacementMode="Compact"
                                   ValueChanged="AnnotationStrokeWidthInput_ValueChanged"
                                   MinWidth="240"/>
                        <TextBlock x:Name="AnnotationSettingsErrorText"
                                   Foreground="{ThemeResource TextFillColorCriticalBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Behavior">
                <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Automatic Actions"
                                   FontSize="16" FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level1"/>
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Choose which Export actions run automatically after you confirm Annotation. Actions run in order: save, Copy Frame, then Copy Path — the saved file's path is available to Copy Path in the same sequence. Cancelling Annotation runs no automatic actions. A failed action is reported so you can retry it manually."/>
                        <ToggleSwitch x:Name="AutoSaveToggle"
                                      Header="Save automatically"
                                      OnContent="On"
                                      OffContent="Off"
                                      Toggled="AutoSaveToggle_Toggled"
                                      MinWidth="200"/>
                        <ToggleSwitch x:Name="AutoCopyFrameToggle"
                                      Header="Copy Frame automatically"
                                      OnContent="On"
                                      OffContent="Off"
                                      Toggled="AutoCopyFrameToggle_Toggled"
                                      MinWidth="200"/>
                        <ToggleSwitch x:Name="AutoCopyPathToggle"
                                      Header="Copy Path automatically"
                                      OnContent="On"
                                      OffContent="Off"
                                      Toggled="AutoCopyPathToggle_Toggled"
                                      MinWidth="200"/>
                        <TextBlock FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="Copy Path requires a saved file: enable Save automatically or save manually first."/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Export">
                <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="ExportFormatHeading"
                                   FontSize="16" FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level1"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Current format"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="ExportFormatNameText"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ExportFormatExtensionText"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="ExportFormatDescriptionText"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="ExportPlannedFormatsText"
                                   TextWrapping="Wrap"
                                   FontSize="13" FontStyle="Italic"
                                   Margin="0,4,0,0"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Interface">
                <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="InterfaceHeading"
                                   FontSize="16" FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level1"/>
                        <TextBlock x:Name="InterfaceMessageText"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="InterfacePlannedText"
                                   TextWrapping="Wrap"
                                   FontSize="13" FontStyle="Italic"
                                   Margin="0,4,0,0"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>

        <!-- Command buttons and status row -->
        <Grid Grid.Row="1" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ResetButton"
                    Grid.Column="0"
                    Content="Reset to Defaults"
                    MinHeight="36"
                    Margin="0,0,16,0"
                    Click="Reset_Click"
                    CornerRadius="6"/>

            <Button x:Name="OKButton"
                    Grid.Column="1"
                    Content="OK"
                    MinWidth="80" MinHeight="36"
                    Margin="0,0,8,0"
                    Click="OK_Click"
                    CornerRadius="6"/>

            <Button x:Name="CancelButton"
                    Grid.Column="2"
                    Content="Cancel"
                    MinWidth="80" MinHeight="36"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"
                    CornerRadius="6"/>

            <Button x:Name="ApplyButton"
                    Grid.Column="3"
                    Content="Apply"
                    MinWidth="80" MinHeight="36"
                    Margin="0,0,16,0"
                    Click="Apply_Click"
                    CornerRadius="6"/>

            <TextBlock x:Name="SaveStatusText"
                       Grid.Column="5"
                       Text=""
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="13"/>
        </Grid>
    </Grid>
</Window>
