<!-- MainWindow.xaml — Capture preview window with toolbar, scrollable image, and diagnostics bar.

Layout:
  ┌─────────────────────────────────────────┐
  │  Toolbar: [Full Desktop] [Current Mon]  │
  ├─────────────────────────────────────────┤
  │                                         │
  │         Scrollable Preview Image        │
  │                                         │
  ├─────────────────────────────────────────┤
  │  Status  │  Timing (tabular-nums)       │
  └─────────────────────────────────────────┘
-->
<Window
    x:Class="captcho.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="captcho — Screen Capture Preview">

    <Grid RowSpacing="0" Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar row -->
        <Grid Grid.Row="1" Padding="12,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="FullDesktopButton"
                    Grid.Column="0"
                    Content="Full Desktop"
                    MinWidth="140" MinHeight="40"
                    Margin="0,0,8,0"
                    Click="FullDesktop_Click"
                    CornerRadius="6"/>

            <Button x:Name="CurrentMonitorButton"
                    Grid.Column="1"
                    Content="Current Monitor"
                    MinWidth="140" MinHeight="40"
                    Margin="0,0,8,0"
                    Click="CurrentMonitor_Click"
                    CornerRadius="6"/>

            <Button x:Name="ActiveWindowButton"
                    Grid.Column="2"
                    Content="Active Window"
                    MinWidth="140" MinHeight="40"
                    Margin="0,0,8,0"
                    Click="ActiveWindow_Click"
                    CornerRadius="6"/>

            <Button x:Name="WindowUnderCursorButton"
                    Grid.Column="3"
                    Content="Window Under Cursor"
                    MinWidth="140" MinHeight="40"
                    Margin="0,0,8,0"
                    Click="WindowUnderCursor_Click"
                    CornerRadius="6"/>

            <Button x:Name="RegionCaptureButton"
                    Grid.Column="4"
                    Content="Rectangular Region"
                    MinWidth="140" MinHeight="40"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Left"
                    Click="RegionCapture_Click"
                    CornerRadius="6"/>

            <Button x:Name="SelectedMonitorButton"
                    Grid.Column="5"
                    Content="Selected Monitor"
                    MinWidth="140" MinHeight="40"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Left"
                    Click="SelectedMonitor_Click"
                    CornerRadius="6"
                    ToolTipService.ToolTip="Pick a monitor by clicking it"/>

            <Button x:Name="SelectedWindowButton"
                    Grid.Column="6"
                    Content="Selected Window"
                    MinWidth="140" MinHeight="40"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Left"
                    Click="SelectedWindow_Click"
                    CornerRadius="6"
                    ToolTipService.ToolTip="Pick a window by clicking it"/>

            <!-- Export separator -->
            <Border x:Name="ExportSeparator"
                    Grid.Column="7"
                    Width="1" Margin="4,4"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Recognize Text + Scan QR: disabled until a capture succeeds -->
            <StackPanel Grid.Column="8" Orientation="Horizontal">
                <Button x:Name="RecognizeTextButton"
                        Content="Recognize Text"
                        MinWidth="120" MinHeight="40"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        IsEnabled="False"
                        Click="RecognizeText_Click"
                        CornerRadius="6"
                        ToolTipService.ToolTip="Recognize text in the captured Frame with Windows OCR"/>

                <Button x:Name="ScanQrButton"
                        Content="Scan QR"
                        MinWidth="90" MinHeight="40"
                        Margin="8,0,8,0"
                        VerticalAlignment="Stretch"
                        IsEnabled="False"
                        Click="ScanQr_Click"
                        CornerRadius="6"
                        ToolTipService.ToolTip="Scan QR codes in the captured Frame"/>
            </StackPanel>

            <!-- Menu separator -->
            <Border x:Name="MenuSeparator"
                    Grid.Column="9"
                    Width="1" Margin="4,4"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Settings button -->
            <Button x:Name="SettingsButton"
                    Grid.Column="10"
                    Content="Settings…"
                    MinWidth="90" MinHeight="40"
                    Margin="8,0,8,0"
                    Click="Settings_Click"
                    CornerRadius="6"
                    ToolTipService.ToolTip="Open settings (F4 or Ctrl+,)"/>

            <!-- About button -->
            <Button x:Name="AboutButton"
                    Grid.Column="11"
                    Content="About"
                    MinWidth="80" MinHeight="40"
                    Margin="8,0,8,0"
                    Click="About_Click"
                    CornerRadius="6"/>

            <!-- Exit button -->
            <Button x:Name="ExitButton"
                    Grid.Column="12"
                    Content="Exit"
                    MinWidth="80" MinHeight="40"
                    Margin="8,0,8,0"
                    Click="Exit_Click"
                    CornerRadius="6"/>

            <!-- Export buttons: disabled until a capture succeeds -->
            <Button x:Name="SaveButton"
                    Grid.Column="13"
                    Content="Save"
                    MinWidth="80" MinHeight="40"
                    Margin="0,0,6,0"
                    IsEnabled="False"
                    Click="Save_Click"
                    CornerRadius="6"
                    ToolTipService.ToolTip="Save to default location"/>

            <Button x:Name="SaveAsButton"
                    Grid.Column="14"
                    Content="Save As…"
                    MinWidth="90" MinHeight="40"
                    Margin="0,0,6,0"
                    IsEnabled="False"
                    Click="SaveAs_Click"
                    CornerRadius="6"
                    ToolTipService.ToolTip="Choose location and filename"/>

            <Button x:Name="CopyToClipboardButton"
                    Grid.Column="15"
                    Content="Copy"
                    MinWidth="80" MinHeight="40"
                    Margin="0,0,6,0"
                    IsEnabled="False"
                    Click="CopyToClipboard_Click"
                    CornerRadius="6"
                    ToolTipService.ToolTip="Copy screenshot to clipboard"/>

            <Button x:Name="CopyPathButton"
                    Grid.Column="15"
                    Content="Copy Path"
                    MinWidth="90" MinHeight="40"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="CopyPath_Click"
                    CornerRadius="6"
                    ToolTipService.ToolTip="Copy the saved file's path (available after a save)"/>

            <!-- Delay input: compact NumberBox for 0–60 second countdown -->
            <NumberBox x:Name="DelaySecondsInput"
                       Grid.Column="16"
                       Header="Delay (s)"
                       Minimum="0" Maximum="60"
                       SmallChange="1" LargeChange="5"
                       Value="0" SpinButtonPlacementMode="Compact"
                       MinWidth="100" MaxWidth="120"
                       MinHeight="40"
                       Margin="8,0,8,0"
                       HorizontalAlignment="Right"
                       CornerRadius="6"/>

            <!-- Countdown progress: determinate bar hidden when idle -->
            <ProgressBar x:Name="CountdownProgress"
                         Grid.Column="17"
                         Width="120" MinHeight="6"
                         Margin="8,0,4,0"
                         VerticalAlignment="Center"
                         Visibility="Collapsed"
                         Minimum="0" Maximum="100" Value="0"
                         ShowError="False" ShowPaused="False"/>

            <!-- Cancel countdown button: hidden when idle -->
            <Button x:Name="CancelDelayButton"
                    Grid.Column="18"
                    Content="Cancel"
                    MinWidth="70" MinHeight="40"
                    Margin="4,0,0,0"
                    Visibility="Collapsed"
                    Click="CancelDelay_Click"
                    CornerRadius="6"/>

            <ProgressRing x:Name="CaptureProgress"
                          Grid.Column="19"
                          Width="28" Height="28"
                          Margin="4,0,0,0"
                          Visibility="Collapsed"
                          IsActive="True"/>
        </Grid>

        <!-- Preview image row -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                      Padding="8">
            <Image x:Name="PreviewImage"
                   Stretch="None"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </ScrollViewer>

        <!-- Status / diagnostics bar -->
        <Grid Grid.Row="2" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Text="Ready — choose a capture mode."
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       FontSize="13"/>

            <TextBlock x:Name="TimingText"
                       Grid.Column="1"
                       Text=""
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontFamily="Consolas, Cascadia Mono, Courier New"
                       Margin="16,0,0,0"/>
        </Grid>
    </Grid>
</Window>
